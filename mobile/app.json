{
  "expo": {
    "name": "Cuppa",
    "slug": "cuppa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cuppa",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#c5522a"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cuppa.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cuppa uses your location to show nearby shifts and record your clock-in location.",
        "NSCameraUsageDescription": "Cuppa needs camera access to upload your profile photo.",
        "NSPhotoLibraryUsageDescription": "Cuppa needs photo library access to upload your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#c5522a"
      },
      "package": "com.cuppa.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c5522a"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cuppa uses your location to show nearby shifts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cuppa needs photo library access for your profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
